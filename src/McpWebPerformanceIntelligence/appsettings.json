{
  "Performance": {
    "PageSpeedApiUrl": "https://www.googleapis.com/pagespeedonline/v5/runPagespeed",
    "ApiTimeoutSeconds": 60,
    "DatabasePath": "mcp_performance.db",
    "PerformanceScoreThreshold": 70.0,
    "FcpThresholdMs": 1800.0,
    "TtiThresholdMs": 3800.0,
    "TbtThresholdMs": 300.0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
